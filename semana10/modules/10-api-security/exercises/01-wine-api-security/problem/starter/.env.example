# Configuración de la Wine Quality API (S10).
# Copia este archivo a `.env` y sustituye cada clave de ejemplo por una
# aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# `.env` está en .gitignore: nunca lo subas al repositorio.

# Predictor: `ready` o `unavailable` (simula un modelo no cargado).
WINE_API_MODE=ready

# Clientes permitidos (JSON): `front` predice; `ops` predice y consulta uso.
# Sustituye ambas claves de ejemplo por valores aleatorios antes de desplegar.
WINE_API_CLIENTS='{"front":{"key":"cambia-front-por-una-clave-aleatoria","scopes":["predict"],"rate_limit_per_minute":60},"ops":{"key":"cambia-ops-por-una-clave-aleatoria","scopes":["predict","admin"],"rate_limit_per_minute":120}}'

# Orígenes web autorizados (lista JSON).
WINE_API_CORS_ORIGINS='["http://localhost:8501"]'

# Activa o desactiva Swagger, ReDoc y el endpoint OpenAPI.
WINE_API_DOCS_ENABLED=true
